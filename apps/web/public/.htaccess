# Apache hosting: make sure an updated NZOSA is the one that actually loads.
#
# The page, its styles and its bundle keep the same names from one build to the
# next, so a browser holding yesterday's copy will go on running yesterday's app
# against today's books -- and the person has no way to tell, because it looks
# exactly like the app. That matters more here than in most places: the bug they
# hit may be one that was fixed a fortnight ago.
#
# "no-cache" does not mean "do not store". It means ask before reusing, so an
# unchanged file costs one round trip and a 304 rather than a fresh download.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css|map)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Found in the security review of 16 September 2026: the site sent none of
  # these, so a hosted copy had no second line of defence behind the app.
  #
  # The policy is the one that earns its place. Even with no way in found, it
  # decides where a page may send data -- so a bug that did let script run could
  # not post somebody's books to another site, or frame this app inside one.
  # The hash is of the small inline script in index.html; change that script and
  # this must be recomputed, or the loading screen loses its fallback.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-oTz+q8MR8+08GCXffD++8GyxIgNQmdzeNYWBHcmFeKY='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://*.supabase.co; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=()"
</IfModule>

# A folder with no index file listed everything in it. Nothing secret sits in
# these folders, but a listing invites a look and grows its own surprises.
Options -Indexes

# Hosts that do not serve these types leave the browser guessing, and a bundle
# served as text/plain does not run at all.
<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType application/json .json .map
  AddType text/css .css
</IfModule>
