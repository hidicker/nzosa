{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "noEmit": true,
    // An import left behind by a move is invisible in a file this size,
    // and twenty-nine of them had accumulated before anybody counted.
    "noUnusedLocals": true,
    "rootDir": "src"
  },
  "include": ["src/**/*.ts"],
  "references": [{ "path": "../../packages/core" }]
}
